# ===========================================
# ApexLeap - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/post-auth
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/post-auth

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Email — Resend  (https://resend.com)
# Plan gratuito: 3.000 correos/mes, 100/día
# ─────────────────────────────────────────────
# 1. Crea cuenta en https://resend.com
# 2. Ve a API Keys → Create API Key → copia la clave aquí
RESEND_API_KEY=re_xxxxxxxx

# Dirección de origen de los correos.
# Sin dominio propio: usa "onboarding@resend.dev" (solo puedes enviar a tu propio email de Resend en pruebas).
# Con dominio propio: verifica el dominio en Resend → Domains y usa tu dirección personalizada.
RESEND_FROM_EMAIL="ApexLeap <onboarding@resend.dev>"

# URL de la app (se usa en los links de los correos)
# En producción: https://apexleap.vercel.app  (o tu dominio personalizado)
NEXT_PUBLIC_APP_URL=https://apexleap.vercel.app

# Opcional: correos de auth (magic link, verificación) se configuran en Clerk Dashboard → Email
