# ===========================================
# ApexLeap - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/post-auth
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/post-auth

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend) — inscripciones: aprobación / rechazo al alumno
# https://resend.com/docs
RESEND_API_KEY=re_xxxxxxxx
# Dominio verificado en Resend; en pruebas puedes usar "onboarding@resend.dev" solo hacia tu email de cuenta
RESEND_FROM_EMAIL="ApexLeap <notificaciones@tudominio.com>"

# Opcional: correos de auth (magic link, verificación) se configuran en Clerk Dashboard → Email
