# ============================================================
# ApexLeap - Variables para Docker Production
# ============================================================
# Copia este archivo como .env y completa los valores
#   cp .env.docker.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=cambia-esto-minimo-32-caracteres-seguro
POSTGRES_DB=postgres

# --- JWT (genera con: openssl rand -base64 32) ---
# Luego genera ANON_KEY y SERVICE_ROLE_KEY en:
# https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
JWT_SECRET=cambia-esto-minimo-32-caracteres-seguro

# JWT firmado con role=anon
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT firmado con role=service_role
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Supabase URL (la URL pública donde estará el proxy) ---
NEXT_PUBLIC_SUPABASE_URL=https://tudominio.com

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
CLERK_SECRET_KEY=sk_live_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# --- App ---
NEXT_PUBLIC_APP_URL=https://tudominio.com

# --- Puertos (opcional, cambiar si hay conflictos) ---
# PORT=80
# POSTGRES_PORT=5432
